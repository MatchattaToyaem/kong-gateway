_format_version: "3.0"
_transform: true

# ---------------------------------------------------------------------------
# Services and routes
# All downstream URLs use external Azure Container Apps FQDNs.
# ---------------------------------------------------------------------------

services:
  # ------------------------------------------------------------------
  # Authentication service — /api/auth/{token,refresh,logout}
  # JWT is NOT required here (these endpoints issue tokens).
  # Rate-limited to slow down brute-force attempts.
  # ------------------------------------------------------------------
  - name: authentication-service
    url: https://authentication-service.proudground-90080d26.australiaeast.azurecontainerapps.io
    routes:
      - name: auth-routes
        paths:
          - /api/auth
        strip_path: false
    plugins:
      - name: cors
        config:
          origins:
            - "*"
          methods:
            - GET
            - POST
            - PUT
            - PATCH
            - DELETE
            - OPTIONS
          headers:
            - Authorization
            - Content-Type
          credentials: true
          max_age: 3600
      - name: rate-limiting
        config:
          minute: 20
          policy: local

  # ------------------------------------------------------------------
  # Chat service — REST session management + WebSocket (STOMP).
  #
  # REST  (ChatSessionController):
  #   GET    /api/chat-sessions
  #   POST   /api/chat-sessions
  #   GET    /api/chat-sessions/{id}
  #   PUT    /api/chat-sessions/{id}
  #   DELETE /api/chat-sessions/{id}
  #   GET    /api/chat-sessions/user/{userName}
  #   PUT    /api/chat-sessions/answer-rating/{id}
  #
  # WebSocket (STOMP broker endpoint):
  #   WS/WSS /ws  →  STOMP destination /app/chat
  # ------------------------------------------------------------------
  - name: chat-service
    url: https://chat-service.proudground-90080d26.australiaeast.azurecontainerapps.io
    routes:
      - name: chat-session-routes
        paths:
          - /api/chat-sessions
        strip_path: false
      - name: chat-ws-routes
        paths:
          - /ws
        strip_path: false
        protocols:
          - http
          - https
    plugins:
      - name: jwt
        config:
          claims_to_verify:
            - exp
          key_claim_name: iss
      - name: cors
        config:
          origins:
            - "*"
          methods:
            - GET
            - POST
            - PUT
            - PATCH
            - DELETE
            - OPTIONS
          headers:
            - Authorization
            - Content-Type
          credentials: true
          max_age: 3600
      - name: rate-limiting
        config:
          minute: 60
          policy: local

  # ------------------------------------------------------------------
  # Document service — SharePoint document retrieval and OCR trigger.
  #
  # DocumentRetrievalController:
  #   GET  /documents/file?path=<sharepoint-path>
  #   GET  /documents/failed?page=&size=&from=&to=
  #
  # OcrTriggerController:
  #   GET  /ocr-trigger
  #
  # FailedDocumentController:
  #   (served under /documents/failed — covered by document-routes)
  # ------------------------------------------------------------------
  - name: document-service
    url: https://document-service.proudground-90080d26.australiaeast.azurecontainerapps.io
    routes:
      - name: document-routes
        paths:
          - /documents
        strip_path: false
      - name: ocr-trigger-routes
        paths:
          - /ocr-trigger
        strip_path: false
    plugins:
      - name: jwt
        config:
          claims_to_verify:
            - exp
          key_claim_name: iss
      - name: cors
        config:
          origins:
            - "*"
          methods:
            - GET
            - POST
            - PUT
            - PATCH
            - DELETE
            - OPTIONS
          headers:
            - Authorization
            - Content-Type
          credentials: true
          max_age: 3600
      - name: rate-limiting
        config:
          minute: 30
          policy: local

  # ------------------------------------------------------------------
  # Chatbot service — FastAPI RAG service (port 8000).
  #
  # POST  /api/chatbot/search   →  /search  (retrieval only, no LLM)
  # POST  /api/chatbot/ask      →  /ask     (full RAG Q&A)
  # GET   /api/chatbot/health   →  /health  (system status)
  # GET   /api/chatbot/         →  /        (service info)
  #
  # strip_path: true strips /api/chatbot, forwarding the remainder
  # (e.g. /api/chatbot/ask → /ask on the upstream FastAPI app).
  # ------------------------------------------------------------------
  - name: chatbot-service
    url: https://chatbot-service.proudground-90080d26.australiaeast.azurecontainerapps.io
    routes:
      - name: chatbot-routes
        paths:
          - /api/chatbot
        strip_path: true
    plugins:
      - name: jwt
        config:
          claims_to_verify:
            - exp
          key_claim_name: iss
      - name: cors
        config:
          origins:
            - "*"
          methods:
            - GET
            - POST
            - PUT
            - PATCH
            - DELETE
            - OPTIONS
          headers:
            - Authorization
            - Content-Type
          credentials: true
          max_age: 3600
      - name: rate-limiting
        config:
          minute: 30
          policy: local

# ---------------------------------------------------------------------------
# Consumer
# key    = JWT_ISSUER_URI from Key Vault — must match the 'iss' claim in tokens
# secret = JWT_SECRET from Key Vault — stored base64-encoded, so secret_is_base64
#          tells Kong to decode it before verifying the HMAC signature, matching
#          what JwtTokenProvider does (Base64.getDecoder().decode(base64Secret)).
# ---------------------------------------------------------------------------
consumers:
  - username: platform-consumer
    jwt_secrets:
      - algorithm: HS256
        key: ${JWT_ISSUER_URI}
        secret: ${JWT_SECRET}
        secret_is_base64: true
